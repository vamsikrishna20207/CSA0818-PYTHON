list1 = [3, 1, 7]
list2 = [6, 2, 4]
merged = list1 + list2

# Simple sorting without using built-in sorted()
for i in range(len(merged)):
    for j in range(i + 1, len(merged)):
        if merged[i] > merged[j]:
            merged[i], merged[j] = merged[j], merged[i]

print("Merged and sorted list:", merged)
